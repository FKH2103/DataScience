    <dashboard name='TB Burden Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#42526e' fontname='Shabnam' fontsize='17'>بخش سوم: شناسایی کشورهای با بیشترین بار بیماری</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='787' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='9' param='vert' removable='false' type='layout-flow' w='98426' x='787' y='830'>
            <zone h='98340' id='7' param='vert' removable='false' type='layout-flow' w='98426' x='787' y='830'>
              <zone h='98340' id='1' param='vert' removable='false' type='layout-flow' w='98426' x='787' y='830'>
                <zone fixed-size='155' h='16079' id='4' is-fixed='true' paired-zone-id='5' removable='false' type='flipboard-nav' w='98426' x='787' y='830' />
                <zone h='82261' id='5' paired-zone-id='4' removable='false' type='flipboard' w='98426' x='787' y='16909'>
                  <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='عنوان :نمای کلی جهانی&#10;نقشه نشان می‌دهد که بالاترین نرخ بروز سل در کشورهای آفریقایی است. در سال ۲۰۱۳، مجموع موارد جدید گزارش شده حدود ۹ میلیون نفر در سطح جهان بوده است.مجموع موارد گزارش شده از سال ۱۹۹۰ تا ۲۰۱۳ بیش از ۲۱۶ میلیون نفر بوده است.' captured-sheet='Dashboard 1' id='1' />
                      <story-point caption='عنوان: مقایسه روند زمانی&#10;بررسی روند سالانه نشان می‌دهد که منطقه آفریقا (AFR) و شرق مدیترانه (EMR) دارای بالاترین میزان بروز بیماری هستند. فیلتر کناری امکان تحلیل جزئیات هر منطقه را فراهم می‌کند.&#10;' captured-sheet='Dashboard 2 - Regional' id='2' />
                      <story-point caption=' عنوان:تمرکز بر کشورهای پرخطر&#10;با استفاده از فیلتر، مشاهده می‌شود که کشورهای هند، چین و اندونزی بیشترین تعداد موارد جدید ابتلا به سل را در سال ۲۰۱۳ به خود اختصاص داده‌اند.' captured-sheet='Dashboard 3' id='3' />
                    </story-points>
                  </flipboard>
                </zone>
              </zone>
            </zone>
          </zone>
